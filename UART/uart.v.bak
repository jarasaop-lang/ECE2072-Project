always @(posedge clk) begin

    if (!busy) begin

        tx <= 1'b1;              // idle

        if (start) begin
            busy       <= 1'b1;
            tx         <= 1'b0;  // start bit
            baud_count <= 13'd0;
            bit_count  <= 4'd0;
        end

    end

    else begin

        if (baud_count == 13'd5207) begin

            if (bit_count < 8) begin

                baud_count <= 13'd0;
                tx         <= data[bit_count];
                bit_count  <= bit_count + 1'b1;

            end

            else if (bit_count == 8) begin

                tx         <= 1'b1;    // start stop bit
                bit_count  <= bit_count + 1'b1;
                baud_count <= 13'd0;

            end

            else begin

                busy <= 1'b0;          // stop bit finished

            end

        end

        else begin

            baud_count <= baud_count + 1'b1;

        end

    end

end