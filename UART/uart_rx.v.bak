module uart_rx (
    input clk,
	 output reg [7:0] data,
    input rx,
	 input reset

	
);
    reg active;
    reg [24:0] baud_count;
    reg [3:0] bit_count;
	 
    initial begin


		  data <= 8'd0;
        baud_count <= 13'd0;
        bit_count  <= 4'd0;
		  active <= 1'b0;
		  
    end	
	always@(posedge clk) begin
      if (reset) begin
			 active <= 1'd0;
			 data <= 8'd0;
          baud_count <= 13'd0;
          bit_count  <= 4'd0;
		end 

		else if (!active) begin

			if (rx == 1'b0) begin

				if (baud_count == 25'd24999999/2) begin
					active     <= 1'b1;
					baud_count <= 25'd0;
					bit_count  <= 4'd0;
				end
				else begin
					baud_count <= baud_count + 1'b1;
				end

			end
			else begin
				baud_count <= 25'd0;
			end

		end
		
		
		else if (active) begin
            if (baud_count == 25'd24999999) begin

                if (bit_count < 8) begin

                    baud_count <= 13'd0;
                    data[bit_count] <= rx;
                    bit_count  <= bit_count + 1'b1;

                end

                else if (bit_count == 8) begin
						 if(rx == 1'b1) begin
            
							bit_count  <= bit_count + 1'b1;
							baud_count <= 13'd0;
							

						 end 
                end

                else begin

                    active <= 1'b0;

                end

            end

            else begin

                baud_count <= baud_count + 1'b1;

            end
		end 
	end 
endmodule 

			 
		
			 

			 
			 
			 
			
			